    "    \n",
    "    hdfs_metrics = extract_metrics(result_hdfs.stdout)\n",
    "    bgl_metrics = extract_metrics(result_bgl.stdout)\n",
    "    \n",
    "    print(f\"\\n{'Metric':<30} {'HDFS':<20} {'BGL':<20}\")\n",
    "    print(\"-\" * 70)\n",
    "    print(f\"{'Total log lines':<30} {hdfs_metrics.get('total_lines', 'N/A'):<20} {bgl_metrics.get('total_lines', 'N/A'):<20}\")\n",
    "    print(f\"{'Unique templates':<30} {hdfs_metrics.get('unique_templates', 'N/A'):<20} {bgl_metrics.get('unique_templates', 'N/A'):<20}\")\n",
    "    \n",
    "    if hdfs_metrics.get('total_lines') and bgl_metrics.get('total_lines'):\n",
