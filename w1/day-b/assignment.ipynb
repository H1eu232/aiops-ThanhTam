   "source": [
    "# AIOps Assignment W1-D2: Log Mining & Anomaly Detection with Drain3\n",
    "**Objective:** Parse system logs using Drain3, detect anomalies via template analysis, build cross-signal anomaly detector\n",
    "\n",
    "---\n",
    "\n",
    "## PHASE 1: LOG PARSING WITH DRAIN3"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1.1: Import Required Libraries & Download Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "import os\n",
    "import urllib.request\n",
    "import zipfile\n",
    "from drain3 import TemplateMiner\n",
    "from drain3.template_miner_config import TemplateMinerConfig\n",
    "from drain3 import TemplateMiner\n",
    "TemplateMiner.get_num_clusters = lambda self: len(self.drain.clusters)\n",
    "from sklearn.ensemble import IsolationForest\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "from sklearn.cluster import AgglomerativeClustering\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Create results directory\n",
    "os.makedirs('results', exist_ok=True)\n",
    "\n",
    "print(\" Libraries imported successfully\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Download HDFS dataset if not exists\n",
    "import os\n",
    "\n",
    "log_file = 'HDFS_2k.log'\n",
    "bgl_file = 'BGL_2k.log'\n",
    "\n",
    "if not os.path.exists(log_file):\n",
    "    print(f\"Downloading {log_file}...\")\n",
    "    url = \"https://github.com/logpai/loghub/raw/master/HDFS/HDFS_2k.log\"\n",
    "    try:\n",
    "        urllib.request.urlretrieve(url, log_file)\n",
    "        print(f\" Downloaded {log_file}\")\n",
    "    except Exception as e:\n",
    "        print(f\" Failed to download: {e}\")\n",
    "        print(\"Please download manually from: https://github.com/logpai/loghub\")\n",
    "else:\n",
    "    print(f\" {log_file} already exists\")\n",
    "\n",
    "# Download BGL dataset for cross-dataset comparison (Phase 4)\n",
    "if not os.path.exists(bgl_file):\n",
    "    print(f\"Downloading {bgl_file}...\")\n",
    "    url = \"https://github.com/logpai/loghub/raw/master/BGL/BGL_2k.log\"\n",
    "    try:\n",
    "        urllib.request.urlretrieve(url, bgl_file)\n",
    "        print(f\" Downloaded {bgl_file}\")\n",
    "    except Exception as e:\n",
    "        print(f\" Failed to download: {e}\")\n",
    "else:\n",
    "    print(f\" {bgl_file} already exists\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1.2: Load and Explore Log Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Count total lines in log file\n",
    "def count_log_lines(filepath):\n",
    "    with open(filepath, 'r') as f:\n",
    "        return sum(1 for _ in f)\n",
    "\n",
    "total_lines_hdfs = count_log_lines(log_file)\n",
    "print(f\"=== HDFS Log File Statistics ===\")\n",
    "print(f\"Total log lines: {total_lines_hdfs:,}\")\n",
    "\n",
    "# Read sample logs\n",
    "with open(log_file, 'r') as f:\n",
    "    sample_logs = [f.readline() for _ in range(5)]\n",
    "    \n",
    "print(f\"\\nFirst 5 log lines:\")\n",
    "for i, log in enumerate(sample_logs, 1):\n",
    "    print(f\"  {i}: {log.strip()[:100]}...\")\n",
    "\n",
    "# Check file size\n",
    "import os\n",
    "file_size = os.path.getsize(log_file) / (1024 * 1024)\n",
    "print(f\"\\nFile size: {file_size:.2f} MB\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1.3: Parse Logs with Drain3 (Default Parameters)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define regex pattern for HDFS logs\n",
    "# Format: Date Time PID Level Component: Message\n",
    "hdfs_log_pattern = re.compile(r'^(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\w+)\\s+([^:]+):\\s+(.*)$')\n",
    "\n",
    "def parse_logs_with_drain3(filepath, drain_sim_th=0.5, drain_depth=4):\n",
    "    \"\"\"Parse logs using Drain3 and return DataFrame with parsed results\"\"\"\n",
    "    \n",
    "    config = TemplateMinerConfig()\n",
    "    config.drain_sim_th = drain_sim_th\n",
    "    config.drain_depth = drain_depth\n",
    "    miner = TemplateMiner(config=config)\n",
    "    \n",
    "    parsed_logs = []\n",
    "    unmatched_count = 0\n",
    "    \n",
    "    with open(filepath, 'r') as f:\n",
    "        for line_num, line in enumerate(f, 1):\n",
    "            match = hdfs_log_pattern.match(line.strip())\n",
    "            if match:\n",
    "                date, time, pid, level, component, message = match.groups()\n",
    "                # Parse timestamp: date=YYMMDD, time=HHMMSS\n",
    "                try:\n",
    "                    timestamp = pd.to_datetime(f\"20{date[:2]}-{date[2:4]}-{date[4:]} {time[:2]}:{time[2:4]}:{time[4:]}\")\n",
    "                except:\n",
    "                    timestamp = pd.Timestamp.now()\n",
    "                \n",
    "                # Process with Drain3\n",
    "                result = miner.add_log_message(message)\n",
    "                \n",
    "                # Determine ground truth (anomaly label)\n",
    "                is_anomaly = 1 if ('exception' in message.lower() or 'failed' in message.lower()) else 0\n",
    "                \n",
    "                parsed_logs.append({\n",
    "                    'line_num': line_num,\n",
    "                    'timestamp': timestamp,\n",
    "                    'level': level,\n",
    "                    'component': component,\n",
    "                    'message': message,\n",
    "                    'template_id': result['cluster_id'],\n",
    "                    'template': result['template_mined'],\n",
    "                    'ground_truth': is_anomaly\n",
    "                })\n",
    "            else:\n",
    "                unmatched_count += 1\n",
    "            \n",
    "            if (line_num + 1) % 10000 == 0:\n",
    "                print(f\"  Processed {line_num + 1:,} lines, {len(miner.drain.clusters)} templates so far...\")\n",
    "    \n",
    "    df = pd.DataFrame(parsed_logs)\n",
    "    print(f\"\\n Parsing complete: {len(df):,} logs, {unmatched_count} unmatched\")\n",
    "    print(f\"  Unique templates: {len(miner.drain.clusters)}\")\n",
    "    \n",
    "    return df, miner\n",
    "\n",
    "# Parse HDFS logs\n",
    "print(\"Parsing HDFS logs with Drain3 (drain_sim_th=0.5)...\")\n",
    "df_logs, miner_hdfs = parse_logs_with_drain3(log_file, drain_sim_th=0.5)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1.4: Analyze and Export Top-10 Templates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate template statistics\n",
    "template_summary = df_logs.groupby(['template_id', 'template']).size().reset_index(name='count')\n",
    "template_summary['percentage'] = (template_summary['count'] / len(df_logs) * 100).round(2)\n",
    "template_summary = template_summary.sort_values('count', ascending=False)\n",
    "\n",
    "print(f\"\\n=== Template Statistics ===\")\n",
    "print(f\"Total unique templates: {len(template_summary)}\")\n",
    "print(f\"Top-10 templates cover: {template_summary.head(10)['percentage'].sum():.2f}% of logs\")\n",
    "\n",
    "# Export Top-10 templates\n",
    "top_10_templates = template_summary.head(10)[['template_id', 'template', 'count']].reset_index(drop=True)\n",
    "top_10_templates.to_csv('results/top_templates.csv', index=False)\n",
    "print(f\"\\n Exported top-10 templates to results/top_templates.csv\")\n",
    "\n",
    "# Display top-10\n",
    "print(\"\\nTop-10 Templates:\")\n",
    "for idx, row in top_10_templates.iterrows():\n",
    "    print(f\"{idx+1:2d}. [{row['template_id']:3d}] ({row['count']:5d} logs): {row['template'][:80]}...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1.5: Tune Drain3 Parameters (drain_sim_th Comparison)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"\n",
    "Tune drain_sim_th: Similarity threshold for merging clusters\n",
    "- Lower values (0.3): More aggressive merging → fewer templates (risk of over-generalization)\n",
    "- Higher values (0.7): Less merging → more templates (risk of over-specificity)\n",
    "- 0.5: Balance between specificity and generalization\n",
    "\"\"\"\n",
    "\n",
    "# Test different drain_sim_th values\n",
    "test_thresholds = [0.3, 0.5, 0.7]\n",
    "tuning_results = []\n",
    "\n",
    "print(\"=== Tuning drain_sim_th Parameter ===\\n\")\n",
    "\n",
    "for threshold in test_thresholds:\n",
    "    print(f\"Testing drain_sim_th={threshold}...\")\n",
    "    _, miner_test = parse_logs_with_drain3(log_file, drain_sim_th=threshold)\n",
    "    num_templates = len(miner_test.drain.clusters)\n",
    "    tuning_results.append({\n",
    "        'drain_sim_th': threshold,\n",
    "        'num_templates': num_templates\n",
    "    })\n",
    "    print(f\"  Result: {num_templates} unique templates\\n\")\n",
    "\n",
    "tuning_df = pd.DataFrame(tuning_results)\n",
    "print(\"\\n=== Tuning Summary ===\")\n",
    "print(tuning_df.to_string(index=False))\n",
    "\n",
    "# Visualize parameter impact\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(tuning_df['drain_sim_th'], tuning_df['num_templates'], 'b-o', linewidth=2, markersize=8)\n",
    "plt.xlabel('drain_sim_th (Similarity Threshold)', fontsize=12)\n",
    "plt.ylabel('Number of Unique Templates', fontsize=12)\n",
    "plt.title('Impact of drain_sim_th on Template Count', fontsize=13)\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.xticks(test_thresholds)\n",
    "plt.tight_layout()\n",
    "plt.savefig('results/drain_sim_th_tuning.png', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "# Recommendation\n",
    "optimal_idx = tuning_df['num_templates'].idxmin()\n",
    "optimal_threshold = tuning_df.loc[optimal_idx, 'drain_sim_th']\n",
    "print(f\"\\n✓ Optimal drain_sim_th: {optimal_threshold} (produces {tuning_df.loc[optimal_idx, 'num_templates']} templates)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## PHASE 2: ANOMALY DETECTION ON LOGS\n",
    "\n",
    "### Step 2.1: Create Template Count Time Series"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create template count time series with 5-minute windows\n",
    "print(\"Creating template count time series (5-min windows)...\")\n",
    "\n",
    "# Set timestamp as index\n",
    "df_logs_ts = df_logs.set_index('timestamp').sort_index()\n",
    "\n",
    "# Group by 5-minute windows and count each template\n",
    "template_ts = df_logs_ts.groupby([pd.Grouper(freq='5min'), 'template_id']).size().unstack(fill_value=0)\n",
    "\n",
    "# Ground truth: max anomaly label in each window\n",
    "ground_truth_ts = df_logs_ts.groupby(pd.Grouper(freq='5min'))['ground_truth'].max().fillna(0)\n",
    "\n",
    "print(f\" Time series shape: {template_ts.shape}\")\n",
    "print(f\"  Time window: {template_ts.index[0]} to {template_ts.index[-1]}\")\n",
    "print(f\"  Anomalous windows: {int(ground_truth_ts.sum())}\")\n",
    "\n",
    "# Visualize template activity over time\n",
    "fig, axes = plt.subplots(2, 1, figsize=(14, 8))\n",
    "\n",
    "# Total template count per window\n",
    "total_count = template_ts.sum(axis=1)\n",
    "axes[0].plot(total_count.index, total_count.values, 'b-', alpha=0.7, label='Total Template Count')\n",
    "axes[0].scatter(total_count[total_count > total_count.mean() + 2*total_count.std()].index, \n",
    "                total_count[total_count > total_count.mean() + 2*total_count.std()].values, \n",
    "                color='red', s=50, label='Potential Anomalies (3σ)', zorder=5)\n",
    "axes[0].set_ylabel('Log Count per Window', fontsize=11)\n",
    "axes[0].set_title('Template Count Time Series - Total Activity', fontsize=12)\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Ground truth anomalies\n",
    "axes[1].plot(ground_truth_ts.index, ground_truth_ts.values, 'g-', alpha=0.5, label='Ground Truth (Label-based)')\n",
    "axes[1].fill_between(ground_truth_ts.index, ground_truth_ts.values, alpha=0.3, color='green')\n",
    "axes[1].set_xlabel('Time', fontsize=11)\n",
    "axes[1].set_ylabel('Anomaly Label', fontsize=11)\n",
    "axes[1].set_title('Ground Truth Anomalies', fontsize=12)\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('results/template_timeseries.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2.2: Apply Anomaly Detection - 3-Sigma & Isolation Forest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detector 1: 3-Sigma Rule\n",
    "total_count = template_ts.sum(axis=1)\n",
    "mean = total_count.mean()\n",
    "std = total_count.std()\n",
    "threshold_3sigma = mean + 3 * std\n",
    "\n",
    "anomalies_3sigma = (total_count > threshold_3sigma).astype(int)\n",
    "print(f\"=== 3-Sigma Detection ===\")\n",
    "print(f\"Mean: {mean:.2f}, Std: {std:.2f}, Threshold (μ+3σ): {threshold_3sigma:.2f}\")\n",
    "print(f\"Anomalies detected: {anomalies_3sigma.sum()}\")\n",
    "\n",
    "# Detector 2: Isolation Forest\n",
    "clf_if = IsolationForest(n_estimators=100, contamination=0.05, random_state=42)\n",
    "preds_if = clf_if.fit_predict(template_ts.values)\n",
    "anomalies_if = np.where(preds_if == -1, 1, 0)\n",
    "\n",
    "print(f\"\\n=== Isolation Forest Detection ===\")\n",
    "print(f\"Anomalies detected: {anomalies_if.sum()}\")\n",
    "\n",
    "# Evaluate against ground truth\n",
    "common_idx = ground_truth_ts.index.intersection(template_ts.index)\n",
    "\n",
    "# 3-Sigma metrics\n",
    "p_3s = precision_score(ground_truth_ts.loc[common_idx], anomalies_3sigma, zero_division=0)\n",
    "r_3s = recall_score(ground_truth_ts.loc[common_idx], anomalies_3sigma, zero_division=0)\n",
    "f1_3s = f1_score(ground_truth_ts.loc[common_idx], anomalies_3sigma, zero_division=0)\n",
    "\n",
    "# Isolation Forest metrics\n",
    "p_if = precision_score(ground_truth_ts.loc[common_idx], anomalies_if, zero_division=0)\n",
    "r_if = recall_score(ground_truth_ts.loc[common_idx], anomalies_if, zero_division=0)\n",
    "f1_if = f1_score(ground_truth_ts.loc[common_idx], anomalies_if, zero_division=0)\n",
    "\n",
    "# Display results\n",
    "print(f\"\\n=== Performance Metrics (vs Ground Truth) ===\")\n",
    "eval_df = pd.DataFrame({\n",
    "    'Detector': ['3-Sigma', 'Isolation Forest'],\n",
    "    'Precision': [f'{p_3s:.4f}', f'{p_if:.4f}'],\n",
    "    'Recall': [f'{r_3s:.4f}', f'{r_if:.4f}'],\n",
    "    'F1-Score': [f'{f1_3s:.4f}', f'{f1_if:.4f}']\n",
    "})\n",
    "print(eval_df.to_string(index=False))\n",
    "\n",
    "# Visualize detections\n",
    "fig, axes = plt.subplots(3, 1, figsize=(14, 10))\n",
    "\n",
    "# 3-Sigma\n",
    "axes[0].plot(total_count.index, total_count.values, 'b-', alpha=0.6, label='Template Count')\n",
    "axes[0].axhline(threshold_3sigma, color='red', linestyle='--', label=f'3-Sigma Threshold ({threshold_3sigma:.1f})')\n",
    "anom_idx = anomalies_3sigma[anomalies_3sigma == 1].index\n",
    "axes[0].scatter(anom_idx, total_count.loc[anom_idx], color='red', s=100, marker='X', label='Detected Anomaly', zorder=5)\n",
    "axes[0].set_ylabel('Count', fontsize=11)\n",
    "axes[0].set_title('3-Sigma Detection', fontsize=12)\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Isolation Forest\n",
    "axes[1].plot(total_count.index, total_count.values, 'b-', alpha=0.6, label='Template Count')\n",
    "anom_idx_if = template_ts.index[anomalies_if == 1]\n",
    "axes[1].scatter(anom_idx_if, total_count.loc[anom_idx_if], color='orange', s=100, marker='X', label='Detected Anomaly', zorder=5)\n",
    "axes[1].set_ylabel('Count', fontsize=11)\n",
    "axes[1].set_title('Isolation Forest Detection', fontsize=12)\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "# Ground truth\n",
    "axes[2].plot(ground_truth_ts.index, ground_truth_ts.values, 'g-', alpha=0.5, linewidth=2, label='Ground Truth')\n",
    "axes[2].fill_between(ground_truth_ts.index, ground_truth_ts.values, alpha=0.3, color='green')\n",
    "axes[2].set_xlabel('Time', fontsize=11)\n",
    "axes[2].set_ylabel('Anomaly', fontsize=11)\n",
    "axes[2].set_title('Ground Truth Labels', fontsize=12)\n",
    "axes[2].legend()\n",
    "axes[2].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('results/anomaly_detection_comparison.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2.3: Detect Template Spikes and New Templates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detect template spikes (templates with suddenly high count)\n",
    "print(\"=== Template Spike Detection ===\\n\")\n",
    "\n",
    "# For each template, detect when count exceeds 2 std above its mean\n",
    "template_spikes = []\n",
    "for template_id in template_ts.columns:\n",
    "    counts = template_ts[template_id]\n",
    "    counts_nonzero = counts[counts > 0]\n",
    "    \n",
    "    if len(counts_nonzero) > 0:\n",
    "        mean_count = counts_nonzero.mean()\n",
    "        std_count = counts_nonzero.std()\n",
    "        \n",
    "        # Find spikes\n",
    "        spike_threshold = mean_count + 2 * std_count\n",
    "        spike_windows = counts[counts > spike_threshold]\n",
    "        \n",
    "        if len(spike_windows) > 0:\n",
    "            for spike_time, spike_count in spike_windows.items():\n",
    "                template_spikes.append({\n",
    "                    'time': spike_time,\n",
    "                    'template_id': template_id,\n",
    "                    'count': spike_count,\n",
    "                    'template': template_summary[template_summary['template_id'] == template_id]['template'].values[0]\n",
    "                    if template_id in template_summary['template_id'].values else 'Unknown'\n",
    "                })\n",
    "\n",
    "if template_spikes:\n",
    "    spike_df = pd.DataFrame(template_spikes).sort_values('time')\n",
    "    print(f\"Found {len(spike_df)} template spike events:\")\n",
    "    for idx, row in spike_df.head(10).iterrows():\n",
    "        print(f\"  {row['time']} | Template {row['template_id']}: {row['count']} logs | {row['template'][:60]}...\")\n",
    "else:\n",
    "    print(\"No significant spikes detected\")\n",
    "\n",
    "# Detect new templates (first appearance per template)\n",
    "print(\"\\n=== New Templates Detection ===\\n\")\n",
    "\n",
    "new_templates = []\n",
    "for template_id in template_ts.columns:\n",
    "    first_appearance = template_ts[template_ts[template_id] > 0].index[0]\n",
    "    count_first_window = template_ts.loc[first_appearance, template_id]\n",
    "    template_text = template_summary[template_summary['template_id'] == template_id]['template'].values[0] \\\n",
    "                    if template_id in template_summary['template_id'].values else 'Unknown'\n",
    "    \n",
    "    new_templates.append({\n",
    "        'first_time': first_appearance,\n",
    "        'template_id': template_id,\n",
    "        'template': template_text,\n",
    "        'count_first_window': int(count_first_window)\n",
    "    })\n",
    "\n",
    "new_templates_df = pd.DataFrame(new_templates).sort_values('first_time')\n",
    "print(f\"Total new templates appeared: {len(new_templates_df)}\")\n",
    "print(f\"\\nFirst 10 new templates:\")\n",
