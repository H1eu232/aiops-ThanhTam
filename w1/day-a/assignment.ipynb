import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
from statsmodels.graphics.tsaplots import plot_acf

# 1. Load data (Thay đổi đường dẫn file thực tế của bạn)
df = pd.read_csv('https://github.com/numenta/NAB/blob/master/data/realKnownCause/cpu_utilization_asg_misconfiguration.csv', parse_dates=['timestamp'])
df.set_index('timestamp', inplace=True)
value_col = 'value'

# 2. Plot raw time series để nhìn tổng quan
plt.figure(figsize=(12, 4))
plt.plot(df[value_col], label='Raw Metric')
plt.title('Raw Time Series Data')
plt.legend()
plt.show()
